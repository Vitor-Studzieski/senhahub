[Unit]
Description=Verificação criptográfica do backup do SenhaHub
After=senhahub-backup.service

[Service]
Type=oneshot
User=senhahub
Group=senhahub
WorkingDirectory=/opt/senhahub
EnvironmentFile=/etc/senhahub/senhahub.env
ExecStart=/usr/bin/npm run backup:verify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/senhahub/backups /mnt/backup-senhahub
