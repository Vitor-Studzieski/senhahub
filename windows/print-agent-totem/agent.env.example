# Agente do Totem SenhaHub para Bematech MP-4000 TH FI.
# O código é de uso único e expira em 10 minutos.
PRINT_API_URL=https://senhahub.vercel.app
PRINT_ENROLLMENT_CODE=

# O perfil fiscal usa o protocolo de comandos da MP-4000 TH FI.
KIOSK_PRINTER_MODE=mp4000-serial
KIOSK_PRINTER_PORT=COM3
PRINT_SERIAL_BAUD_RATE=9600
PRINT_SERIAL_DATA_BITS=8
PRINT_SERIAL_STOP_BITS=1
PRINT_SERIAL_PARITY=none
PRINT_SERIAL_RTSCTS=1

# A fila é consultada a cada dois segundos para reduzir a espera após a solicitação.
PRINT_POLL_INTERVAL_MS=2000
PRINT_AGENT_STATE_DIR=./data/print-agent-totem
