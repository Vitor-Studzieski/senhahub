# Copie este arquivo para agent.env no mesmo diretório do executável.
PRINT_API_URL=https://senhahub.vercel.app

# Preenchido somente no primeiro pareamento. O código expira após 10 minutos e só pode ser usado uma vez.
PRINT_ENROLLMENT_CODE=

# Alternativa somente para instalações locais provisionadas manualmente.
# PRINT_DEVICE_LOCAL_TOKEN=

# O modo spooler usa a fila instalada no Windows e é o modo recomendado
# para os mini PCs conectados por USB.
# KIOSK_PRINTER_MODE=spooler
# KIOSK_PRINTER_NAME=Bematech MP - 4200 TH
# O modo nativo é uma alternativa para uma porta COM virtual.
KIOSK_PRINTER_MODE=native-serial
KIOSK_PRINTER_PORT=COM5
PRINT_SERIAL_BAUD_RATE=115200
PRINT_SERIAL_DATA_BITS=8
PRINT_SERIAL_STOP_BITS=1
PRINT_SERIAL_PARITY=none
PRINT_SERIAL_RTSCTS=0

# O agente x86 usa uma consulta leve para não depender do Realtime no Windows 32 bits.
# Cinco segundos evitam consultas contínuas sem bloquear o protocolo de impressão.
PRINT_POLL_INTERVAL_MS=5000
PRINT_AGENT_STATE_DIR=data\\print-agent-x86
