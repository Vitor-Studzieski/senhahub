# Agente v2. Código de uso único emitido por administrador (validade: 10 minutos).
PRINT_API_URL=https://senhahub.vercel.app
PRINT_ENROLLMENT_CODE=
# Somente ambientes locais com dispositivo provisionado individualmente:
# PRINT_DEVICE_LOCAL_TOKEN=
PRINT_REALTIME_ENABLED=1
# Reconciliação de segurança: 10 minutos; mínimo permitido: 1 minuto.
PRINT_RECONCILIATION_MS=600000

# Bematech MP-4200 TH conectada como porta serial virtual.
KIOSK_PRINTER_PORT=COM4
PRINT_SERIAL_BAUD_RATE=115200
PRINT_SERIAL_DATA_BITS=8
PRINT_SERIAL_STOP_BITS=1
PRINT_SERIAL_PARITY=none
PRINT_SERIAL_RTSCTS=0

# Ative depois de confirmar que a impressora esta no modo ESC/POS e responde
# ao comando DLE EOT. Se desativado, falhas ainda sao detectadas pela porta.
PRINT_STATUS_CHECK_ENABLED=0
PRINT_STATUS_TIMEOUT_MS=1500

PRINT_AGENT_STATE_DIR=./data/print-agent
